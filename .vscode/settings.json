{
	"workbench.tree.indent": 32,
	"workbench.tree.renderIndentGuides": "always",
    // C++ 智能提示（clangd）：用环境里的 clangd 23（系统 apt 的 clangd 14 读不了 gcc 15 的头），
    // 并让它去问 pixi 的编译器要包含路径。这两项是 window scope：**单独打开本文件夹**时写在这里生效；
    // 用多根工作区（同级的 RoboCon.code-workspace）打开时这里被忽略，要写进工作区文件。
    // 改完执行「clangd: Restart language server」。原因、实测与排查见
    // docs/pitfalls/environment.md 的「C++ 工具链（pixi 提供）与编辑器提示」一节。
    "clangd.path": "${workspaceFolder}/.pixi/envs/default/bin/clangd",
    "clangd.arguments": [
        "--query-driver=**/.pixi/envs/*/bin/*"
    ],
    "cmake.autoDetectSourceDirectory": false,
    "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.cache": true,
        ".pixi": true,
    },
    "python-envs.defaultEnvManager": "renan-r-santos.pixi-code:pixi",
    "python-envs.defaultPackageManager": "renan-r-santos.pixi-code:pixi",
    "cSpell.words": [
        "evdev",
        "rclpy"
    ],
}