<mujoco model="black_flat_scene">
  <!-- 平坦地面场景：只负责环境（地面/灯光/视觉），机器人本体在 models/ 里。
       复用方式与 MuJoCo 官方示例一致：<include> 会在解析阶段把被包含文件的元素合并进来。 -->
  <include file="../models/black_description.xml"/>

  <!-- meshdir 必须在 include **之后**显式写成相对"本场景目录"的路径：MuJoCo 里 `meshdir` 是相对
       **顶层（main）文件**解析的，而不是相对它自己（模型）所在的目录；模型里的 `meshdir="meshes/"`
       到了这里会去 `scenes/meshes/` 找。写上这一行后，`scenes/` 下就不需要那个 `meshes` 目录软链接了
       （在上一版的布局里实测：去掉这一行会去找 `scenes/meshes/…` 而报错）。
       规则与复现见 [../../docs/learn/mujoco.md](../../docs/learn/mujoco.md) §6.1。 -->
  <compiler meshdir="../models/meshes"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <asset>
    <!-- 棋盘格地面纹理：**默认不用**（平的、无限大、又没纹理的地面，从"重力水平"的相机看过去
         与倾斜地面在画面上几乎一样，坡度看不出来）。它随场景一起从 @20260927_motor 复制过来，
         那边的程序只在给了坡度参数时才把 floor_grid_mat 挂到 floor 上；本任务不做坡度，
         留着它只是让两份场景保持逐项可比。
         builtin=checker 是 MuJoCo 自带的程序化纹理，不需要外部图片。 -->
    <texture name="floor_grid" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.85 0.85 0.85" rgb2="0.62 0.62 0.64"/>
    <material name="floor_grid_mat" texture="floor_grid" texrepeat="4 4" rgba="1 1 1 1"/>
  </asset>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <!-- 平坦地形：type=plane 是无限大平面，size 只影响显示；放在 z=0。
         friction = 滑动/自旋/滚动三系数（condim=3 只用第 1 个）。上一版的程序可以用命令行开关
         覆盖地面摩擦与倾角（改摩擦要连 4 个足底碰撞球一起改：MuJoCo 的接触摩擦是两个 geom
         逐元素取较大者，只改地面不生效）；本任务固定用这一组值。 -->
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"
          condim="3" friction="1 0.005 0.0001"/>
  </worldbody>

  <!-- 初始状态：零力矩趴在平地上。
       qpos = 7(基座 pos + quat) + 12(关节角，顺序 FL/FR/RR/RL × hip/thigh/calf)。
       这组数值不是手调的：让模型从"脚刚好触地"的站立姿态自由落下、收敛成四肢收拢的趴卧姿态后
       取其 qpos；xy 清零（平面上平移等价），所以放上去即静止，不需要"先掉一下"。
       量它的脚本在第二次培训的任务目录里（@20260923_mujoco/scripts/agent_scripts/rest_check.py，
       用它的 drop 模式复验）——本任务直接沿用这组数，没有重新标定。 -->
  <keyframe>
    <key name="rest" qpos="0 0 0.1449 1 0 0 0.0015
                            0.5014  1.6008 -2.5542
                           -0.5014 -1.6008  2.5542
                            0.5014 -1.6008  2.5542
                           -0.5014  1.6008 -2.5542"/>
  </keyframe>
</mujoco>
