<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_ros2</name>
  <version>0.1.0</version>
  <description>四足机器人 ROS 2 任务：①自定义消息 ②控制器节点（C++）+ MuJoCo 仿真节点（C++）③手柄节点（Python）④launch 一键启动</description>
  <maintainer email="what410802@126.com">What410802</maintainer>
  <license>Apache-2.0</license>

  <!-- 一个包放三样东西：自定义消息 + 两个 C++ 节点 + 一个 Python 节点。
       所以构建类型必须是 ament_cmake（ament_python 不能生成消息）；Python 节点用
       install(PROGRAMS ...) 按可执行文件装到 lib/quadruped_ros2/，这样 ros2 run 也能起。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
